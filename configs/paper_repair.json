{
  "name": "paper_repair",
  "notes": "Paper-scale repair loop. Main dataset = repairable negatives (drop_w_term, flip_w_sign, r_charge_perturb, rank_perturb). positive (do-no-harm) and wrong_pair (abstention) are secondary stress sets included via --include-non-repairable. Feedback verifier uses L=3; final-eval verifier uses the stricter L=6 (anti-gaming guardrail).",
  "depths": [1, 2, 3, 4],
  "fixture_classes": [
    "positive",
    "drop_w_term",
    "flip_w_sign",
    "r_charge_perturb",
    "rank_perturb",
    "wrong_pair"
  ],
  "n_per_cell": 4,
  "seed": 20260531,
  "split": "eval",
  "output_dir": "runs/experiments/paper_repair",
  "verifier": {
    "duality_profile": "phase2c_a_detection",
    "chiral_ring_max_length": 3,
    "require_r_graded": true
  },
  "model": {
    "provider": "dryrun",
    "model": "dryrun",
    "max_tokens": 2048
  },
  "repair": {
    "max_rounds": 5,
    "feedback_mode": "verifier_feedback",
    "feedback_detail": "medium",
    "feedback_verifier": {
      "duality_profile": "phase2c_a_detection",
      "chiral_ring_max_length": 3,
      "require_r_graded": true
    },
    "final_eval_verifier": {
      "duality_profile": "phase2c_a_detection",
      "chiral_ring_max_length": 6,
      "require_r_graded": true
    }
  }
}
