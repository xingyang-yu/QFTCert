{
  "name": "paper_detection",
  "notes": "Paper-scale detection + diagnosis. Requests depths 1-4; depths >= 2 route to attrition (depth_not_implemented) until the mutation engine supports multi-step chains. Set model.provider/model to a real provider to run live.",
  "depths": [1, 2, 3, 4],
  "fixture_classes": [
    "positive",
    "drop_w_term",
    "flip_w_sign",
    "r_charge_perturb",
    "rank_perturb",
    "trivial_rank",
    "wrong_pair"
  ],
  "n_per_cell": 4,
  "seed": 20260530,
  "split": "eval",
  "output_dir": "runs/experiments/paper_detection",
  "verifier": {
    "duality_profile": "phase2c_a_detection",
    "chiral_ring_max_length": 3,
    "require_r_graded": true
  },
  "model": {
    "provider": "dryrun",
    "model": "dryrun",
    "max_tokens": 2048
  },
  "repair": {
    "max_rounds": 5,
    "feedback_mode": "verifier_feedback",
    "feedback_detail": "medium"
  }
}
